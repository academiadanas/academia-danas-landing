---
const phone = '5213171323237';

const slides = [
  {
    badge: { icon: 'bi-award', text: 'MÁS DE 50 ALUMNAS GRADUADAS' },
    titlePre: 'Multiplica tus ingresos con',
    titleHighlight: 'Micropigmentación',
    items: [
      'Genera de $1,800 a $2,500 por procedimiento.',
      'Recupera tu inversión en 3 meses.',
      'Constancia con validez oficial.',
    ],
    cta: { text: 'Ver cursos', href: '#cursos' },
    ctaSecondary: {
      text: 'Más info',
      href: `https://wa.me/${phone}?text=${encodeURIComponent('Hola, me puede dar más información de los cursos de Micropigmentación.')}`,
    },
    image: '/img/hero-micropigmentacion.jpg',
    imageAlt: 'Micropigmentación',
  },
  {
    badge: { icon: 'bi-mortarboard', text: 'DIPLOMADO IDEFT' },
    titlePre: 'Diplomado en',
    titleHighlight: 'Cosmetología',
    items: [
      'Programa completo de 10 meses.',
      'Certificación oficial.',
      'Financiamiento con CrediCompras.',
    ],
    cta: { text: 'Ver diplomado', href: '#cursos' },
    image: '/img/hero-cosmetologia.jpg',
    imageAlt: 'Cosmetología',
  },
  {
    badge: { icon: 'bi-star-fill', text: '20+ AÑOS DE EXPERIENCIA' },
    titleHighlight: 'Aprende y emprende',
    titlePost: 'en el mundo de la belleza',
    items: [
      'Instructoras certificadas.',
      'Grupos reducidos.',
      'Formación con validez oficial para transformar tu futuro.',
    ],
    cta: { text: 'Ver oferta académica', href: '#cursos' },
    image: '/img/hero-general.jpg',
    imageAlt: 'Academia Danas',
  },
];
---

<section id="inicio" style="position: relative; height: 100dvh; min-height: 600px; padding-top: 5rem; display: flex; flex-direction: column; background-color: #fcfbff;">
  <div id="heroSlider" style="position: relative; flex: 1; width: 100%; height: 100%; overflow: hidden;">

    {slides.map((slide, i) => (
      <div
        class="hero-slide"
        style={`position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: ${i === 0 ? 'block' : 'none'};`}
      >
        <div class="container mx-auto h-full px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col md:flex-row h-full items-center gap-8 md:gap-12 lg:gap-20">
            <!-- Text -->
            <div class="w-full md:w-1/2 flex flex-col justify-center items-start pt-8 md:pt-0 z-20 order-1">
              <div>
                <span class="inline-flex items-center gap-2 px-3 py-1 mb-6 text-xs font-bold tracking-wider text-primary bg-primary-50 rounded-full border border-primary/10">
                  <i class={`bi ${slide.badge.icon}`}></i>
                  {slide.badge.text}
                </span>

                <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-[1.1] mb-6">
                  {slide.titlePre && <>{slide.titlePre} </>}
                  <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-dark">
                    {slide.titleHighlight}
                  </span>
                  {slide.titlePost && <> {slide.titlePost}</>}
                </h1>

                <ul class="list-disc pl-5 space-y-2 text-lg text-gray-600 mb-8 leading-relaxed max-w-lg">
                  {slide.items.map((item) => <li>{item}</li>)}
                </ul>

                <div class="flex flex-col sm:flex-row gap-4">
                  <a
                    href={slide.cta.href}
                    class="px-8 py-3.5 bg-primary hover:bg-primary-dark text-white font-semibold rounded-lg shadow-glow transition-all text-center"
                  >
                    {slide.cta.text}
                  </a>
                  {slide.ctaSecondary && (
                    <a
                      href={slide.ctaSecondary.href}
                      class="px-8 py-3.5 bg-white hover:bg-gray-100 text-gray-700 border border-gray-200 font-semibold rounded-lg transition-all text-center flex items-center justify-center gap-2"
                    >
                      <i class="bi bi-whatsapp text-whatsapp"></i>
                      {slide.ctaSecondary.text}
                    </a>
                  )}
                </div>
              </div>
            </div>

            <!-- Image -->
            <div class="w-full md:w-1/2 h-[40vh] md:h-full relative order-2">
              <div class="absolute inset-0 md:my-8 md:mr-0 md:ml-4 rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl">
                <div class="absolute inset-0 bg-primary/10 mix-blend-multiply z-10"></div>
                <img
                  src={slide.image}
                  alt={slide.imageAlt}
                  class="w-full h-full object-cover"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}

  </div>

  <!-- Slider Dots -->
  <div style="position: absolute; bottom: 2rem; left: 0; width: 100%; z-index: 30;">
    <div class="container mx-auto px-4 flex justify-center md:justify-start gap-3">
      {slides.map((_, i) => (
        <button
          class:list={[
            'slider-dot w-3 h-3 rounded-full transition-all hover:scale-125 hover:bg-primary-dark',
            i === 0 ? 'bg-primary' : 'bg-gray-300',
          ]}
          data-slide={i}
          aria-label={`Slide ${i + 1}`}
        />
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var currentSlide = 0;
    var slides = document.querySelectorAll('.hero-slide');
    var dots = document.querySelectorAll('.slider-dot');
    var slideInterval;
    var isAnimating = false;

    // Preparar todos los slides para transiciones
    for (var i = 0; i < slides.length; i++) {
      slides[i].style.transition = 'opacity 0.8s ease-in-out';
      if (i === 0) {
        slides[i].style.display = 'block';
        slides[i].style.opacity = '1';
        slides[i].style.zIndex = '10';
      } else {
        slides[i].style.display = 'block';
        slides[i].style.opacity = '0';
        slides[i].style.zIndex = '0';
        slides[i].style.pointerEvents = 'none';
      }
    }

    function changeSlide(index) {
      if (isAnimating || index === currentSlide) return;
      isAnimating = true;

      var outSlide = slides[currentSlide];
      var inSlide = slides[index];

      // Preparar el nuevo slide debajo
      inSlide.style.zIndex = '5';
      inSlide.style.opacity = '0';
      inSlide.style.pointerEvents = 'none';

      // Forzar reflow para que la transición funcione
      inSlide.offsetHeight;

      // Fade in del nuevo slide
      inSlide.style.opacity = '1';
      inSlide.style.zIndex = '10';
      inSlide.style.pointerEvents = 'auto';

      // Fade out del slide actual
      outSlide.style.opacity = '0';
      outSlide.style.zIndex = '0';
      outSlide.style.pointerEvents = 'none';

      // Actualizar dots
      for (var i = 0; i < dots.length; i++) {
        dots[i].classList.remove('bg-primary');
        dots[i].classList.add('bg-gray-300');
      }
      dots[index].classList.remove('bg-gray-300');
      dots[index].classList.add('bg-primary');

      currentSlide = index;

      setTimeout(function() {
        isAnimating = false;
      }, 800);
    }

    function nextSlide() {
      changeSlide((currentSlide + 1) % slides.length);
    }

    function startTimer() {
      slideInterval = setInterval(nextSlide, 6000);
    }

    for (var i = 0; i < dots.length; i++) {
      (function(dot) {
        dot.addEventListener('click', function() {
          changeSlide(Number(dot.getAttribute('data-slide')));
        });
      })(dots[i]);
    }

    var heroSection = document.getElementById('heroSlider');
    if (heroSection) {
      heroSection.addEventListener('mouseenter', function() {
        clearInterval(slideInterval);
      });
      heroSection.addEventListener('mouseleave', startTimer);
    }

    startTimer();
  });
</script>