---
const problems = [
  {
    icon: 'bi-currency-dollar',
    title: 'Ingresos limitados',
    description: 'Tu ingreso actual no te permite alcanzar tus sueños. Vives con lo justo y anhelas más.',
  },
  {
    icon: 'bi-clock-history',
    title: 'Horarios rígidos',
    description: 'No tienes control sobre tu tiempo. Tu trabajo no te permite balancear vida personal y profesional.',
  },
  {
    icon: 'bi-emoji-frown',
    title: 'Falta de realización',
    description: 'No encuentras satisfacción en lo que haces. Sientes que tu trabajo no te llena ni te apasiona.',
  },
];
---

<section class="py-20 md:py-28 bg-white" id="problemas">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-animate">
      <span class="text-primary font-semibold tracking-wider text-sm uppercase">
        Tu situación actual
      </span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mt-2 mb-4">
        ¿Te identificas con esto?
      </h2>
      <p class="text-gray-500 text-lg">
        Sabemos que buscas más que un simple trabajo, buscas estabilidad y pasión.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {problems.map((item) => (
        <div class="p-8 rounded-2xl bg-gray-50 border border-gray-100 hover:shadow-soft transition-all duration-300 scroll-animate group">
          <div class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center text-primary text-2xl mb-6 group-hover:bg-primary group-hover:text-white transition-colors">
            <i class={`bi ${item.icon}`} />
          </div>
          <h3 class="font-display text-xl font-bold text-gray-900 mb-3">
            {item.title}
          </h3>
          <p class="text-gray-600 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
