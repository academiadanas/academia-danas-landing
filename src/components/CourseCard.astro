---
export interface CourseProps {
  title: string;
  image: string;
  imageAlt: string;
  category: 'cosmetologia' | 'micropigmentacion';
  level: string;
  date: string;
  duration: string;
  schedule: string;
  kitItems: string[];
  inscriptionPrice: string;
  price: string;
  priceLabel?: string;
  whatsappMsg: string;
  hasFinancing?: boolean;
}

interface Props {
  course: CourseProps;
}

const { course } = Astro.props;
const phone = '5213171323237';
const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(course.whatsappMsg)}`;
---

<article
  class="course-card w-full max-w-[350px] group bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-glow transition-all duration-300 flex flex-col h-full relative"
  data-category={course.category}
>
  <!-- Image -->
  <div class="relative overflow-hidden aspect-[16/10]">
    <img
      src={course.image}
      alt={course.imageAlt}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
      loading="lazy"
    />
    <span class="absolute bottom-0 left-0 bg-primary text-white text-[10px] font-bold px-3 py-1 rounded-tr-lg">
      {course.level}
    </span>
  </div>

  <div class="p-5 flex-1 flex flex-col">
    <h3 class="font-display text-xl font-bold text-gray-900 mb-2 leading-tight">
      {course.title}
    </h3>

    <!-- Details -->
    <div class="flex flex-col gap-3 mb-4 py-3 border-b border-gray-100">
      <div class="flex items-start gap-2">
        <div class="p-1.5 bg-primary-50 rounded text-primary flex-shrink-0">
          <i class="bi bi-calendar-check" />
        </div>
        <div>
          <p class="text-[10px] text-gray-500 uppercase font-bold leading-tight">Fecha</p>
          <p class="text-xs font-semibold text-gray-700 leading-tight">{course.date}</p>
        </div>
      </div>

      <div class="flex items-start gap-2">
        <div class="p-1.5 bg-primary-50 rounded text-primary flex-shrink-0">
          <i class="bi bi-hourglass-split" />
        </div>
        <div>
          <p class="text-[10px] text-gray-500 uppercase font-bold leading-tight">Duración</p>
          <p class="text-xs font-semibold text-gray-700 leading-tight">{course.duration}</p>
        </div>
      </div>

      <div class="flex items-start gap-2">
        <div class="p-1.5 bg-primary-50 rounded text-primary flex-shrink-0">
          <i class="bi bi-clock" />
        </div>
        <div>
          <p class="text-[10px] text-gray-500 uppercase font-bold leading-tight">Horario</p>
          <p class="text-xs font-semibold text-gray-700 leading-snug" set:html={course.schedule} />
        </div>
      </div>
    </div>

    <!-- Kit details -->
    <details class="group/details mb-4">
      <summary class="flex justify-between items-center cursor-pointer list-none text-xs font-bold text-gray-700 hover:text-primary transition-colors p-1 rounded hover:bg-gray-50">
        <span class="flex items-center gap-2">
          <i class="bi bi-bag-heart text-primary" />
          ¿Qué incluye el kit?
        </span>
        <span class="transition group-open/details:rotate-180 text-gray-400">
          <i class="bi bi-chevron-down" />
        </span>
      </summary>
      <ul class="text-xs text-gray-600 mt-2 pl-5 space-y-1 list-disc marker:text-primary pb-2">
        {course.kitItems.map((item) => <li>{item}</li>)}
      </ul>
    </details>

    <!-- Financing badge -->
    {course.hasFinancing !== false && (
      <div class="mt-auto mb-5 bg-gray-50 p-3 rounded-xl border border-gray-100 flex items-start gap-3">
        <i class="bi bi-credit-card-2-front-fill text-whatsapp mt-0.5 text-lg" />
        <p class="text-[11px] text-gray-600 leading-tight">
          <strong class="text-gray-900">Meses sin intereses</strong><br />
          Paga con CrediCompras de Caja Popular Cristóbal Colón.
        </p>
      </div>
    )}

    <!-- Price & CTA -->
    <div class="flex items-end justify-between pt-2 border-t border-transparent">
      <div class="flex flex-col gap-1">
        <div class="inline-flex items-center gap-2 px-2 py-1 bg-primary-50 rounded-md border border-primary/10 w-fit">
          <span class="text-[10px] font-bold text-primary uppercase tracking-wide">Inscripción</span>
          <span class="text-sm font-bold text-gray-900">{course.inscriptionPrice}</span>
        </div>
        <div>
          <span class="text-[10px] text-gray-400 block uppercase font-bold tracking-wider ml-0.5">
            {course.priceLabel || 'Mensualidad'}
          </span>
          <span class="text-2xl font-display font-bold text-gray-900 leading-none">
            {course.price}
          </span>
        </div>
      </div>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-3 bg-gray-900 text-white text-xs font-bold rounded-lg shadow-lg hover:bg-primary hover:shadow-glow transition-all transform hover:-translate-y-0.5 flex items-center gap-2 h-fit mb-0.5"
      >
        Inscribirme
      </a>
    </div>
  </div>
</article>
