---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { icon: 'bi-facebook', href: 'https://www.facebook.com/academiadanas/', label: 'Facebook' },
  { icon: 'bi-instagram', href: 'https://www.instagram.com/academia_danas/', label: 'Instagram' },
  { icon: 'bi-tiktok', href: 'https://www.tiktok.com/@academiadanas', label: 'TikTok' },
  { icon: 'bi-youtube', href: 'https://www.youtube.com/@academiadanas', label: 'YouTube' },
];

const quickLinks = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Beneficios', href: '#beneficios' },
  { label: 'Instructora', href: '#instructora' },
  { label: 'Testimonios', href: '#testimonios' },
  { label: 'Preguntas', href: '#faq' },
];
---

<footer class="bg-gray-900 text-gray-300 py-16 border-t border-gray-800">
  <div class="container mx-auto px-4 grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
    <!-- Brand -->
    <div class="col-span-1">
      <img
        src="/img/logo-academia-danas.svg"
        alt="Academia Danas"
        class="h-12 w-auto mb-6"
      />
      <p class="text-sm text-gray-400 mb-6 leading-relaxed">
        Formamos emprendedoras en belleza con cursos accesibles, prácticos y de calidad profesional.
      </p>
      <div class="flex space-x-4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-primary hover:text-white transition-all"
          >
            <i class={`bi ${link.icon}`} />
          </a>
        ))}
      </div>
    </div>

    <!-- Academic Offer -->
    <div>
      <h4 class="text-white font-bold mb-6 text-lg">Oferta Académica</h4>
      <ul class="space-y-3 text-sm">
        <li>
          <a href="#cursos" class="hover:text-primary transition-colors flex items-center">
            <i class="bi bi-chevron-right text-xs mr-2" /> Cosmetología
          </a>
        </li>
        <li>
          <a href="#cursos" class="hover:text-primary transition-colors flex items-center">
            <i class="bi bi-chevron-right text-xs mr-2" /> Micropigmentación
          </a>
        </li>
      </ul>
    </div>

    <!-- Quick Links -->
    <div>
      <h4 class="text-white font-bold mb-6 text-lg">Enlaces Rápidos</h4>
      <ul class="space-y-3 text-sm">
        {quickLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-primary transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h4 class="text-white font-bold mb-6 text-lg">Contacto</h4>
      <ul class="space-y-4 text-sm">
        <li class="flex items-start gap-3">
          <i class="bi bi-geo-alt-fill text-primary mt-0.5" />
          <span>Av. Revolución 192, Autlán de Navarro, Jalisco</span>
        </li>
        <li class="flex items-start gap-3">
          <i class="bi bi-whatsapp text-primary mt-0.5" />
          <a href="https://wa.me/5213171323237" class="hover:text-primary transition-colors">
            317 132 3237
          </a>
        </li>
        <li class="flex items-start gap-3">
          <i class="bi bi-envelope-fill text-primary mt-0.5" />
          <a href="mailto:contacto@academiadanas.com" class="hover:text-primary transition-colors">
            contacto@academiadanas.com
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="container mx-auto px-4 pt-8 border-t border-gray-800">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
      <p>&copy; {currentYear} Academia Danas. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-primary transition-colors">Aviso de Privacidad</a>
        <a href="#" class="hover:text-primary transition-colors">Términos y Condiciones</a>
      </div>
    </div>
  </div>
</footer>
